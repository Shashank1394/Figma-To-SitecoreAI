# Figma Desktop MCP server (enable it in Figma Desktop > Dev Mode)
FIGMA_MCP_URL=http://127.0.0.1:3845/mcp

# OpenRouter API (create a key at https://openrouter.ai/keys)
# The default router selects an available free model. Keep this key server-side.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# SitecoreAI Authoring and Management API — Environment Automation credentials
SITECORE_AI_CM_HOST=https://your-instance.sitecorecloud.io
SITECORE_AI_CLIENT_ID=
SITECORE_AI_CLIENT_SECRET=
