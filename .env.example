# Figma Desktop MCP server (enable it in Figma Desktop > Dev Mode)
FIGMA_MCP_URL=http://127.0.0.1:3845/mcp

# Google Gemini API (obtain a key from Google AI Studio)
# Used by the server-side content-model analyzer. Never prefix with NEXT_PUBLIC_.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# SitecoreAI Authoring and Management API
SITECORE_AI_CM_HOST=https://your-instance.sitecorecloud.io
SITECORE_AI_CLIENT_ID=
SITECORE_AI_CLIENT_SECRET=
